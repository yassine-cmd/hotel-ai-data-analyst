APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agent_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Minutes a web session stays valid after idle activity (default 480 = 8h).
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

# Delegation token lifetime (seconds) granted to the Python data plane.
DELEGATION_TTL=3600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# === Python Agent Connection ===
# URL of the Python AI agent service (FastAPI)
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SOCKET_CONNECT_TIMEOUT=5

# === Instance Authentication (Ed25519) ===
# Every Laravel instance is an admin instance, a client instance, or both
# (dual-role, e.g. a dev box that runs the admin panel and also serves a client).
# Set the key(s) for the role(s) this instance plays:
#
# CLIENT INSTANCE: set CLIENT_PRIVATE_KEY (generate with `php artisan client:keys:generate`).
#   Its public key is registered in the shared DB (clients.public_key) by the admin.
#   Python verifies this instance's analyze requests against that public key.
#
# ADMIN INSTANCE: set ADMIN_PRIVATE_KEY (generate with `php artisan admin:keys:generate`).
#   Its PUBLIC key is set ONLY in the Python agent's ADMIN_PUBLIC_KEY env var (Python
#   verifies admin-signed calls against it). The admin Laravel instance never needs
#   the public key — presence of ADMIN_PRIVATE_KEY is what makes it the admin.
CLIENT_PRIVATE_KEY=
ADMIN_PRIVATE_KEY=
# Encrypts tenant analytics-DB credentials at rest. Deliberately SEPARATE from
# APP_KEY so a routine `php artisan key:generate` can never orphan them. Set
# once per deployment; rotate only via `php artisan clients:rekey`.
# Generate with `php artisan clients:key:generate`.
CLIENT_CREDENTIALS_KEY=
# This instance's own data-plane URL (where Python calls back for SQL).
DATA_PLANE_SELF_URL=http://127.0.0.1:80/api/internal/data/v1

# === System Audit Log ===
# Every instance writes a daily system-audit log file (storage/logs/system-audit-*.log).
# Retention in days; 0 = keep forever (rotation never deletes).
# SYSTEM_AUDIT_RETENTION_DAYS=30
# Minimum level written to the audit channel (debug|info|warning|error|critical).
# SYSTEM_AUDIT_LEVEL=debug
# Client instances forward audit events to Python (PYTHON_SERVICE_URL + /api/events),
# which relays them to the admin instance's log file. Leave EMPTY on the admin
# instance (it is the log sink) to avoid echoing its own events back.
# SYSTEM_AUDIT_FORWARD_URL=http://127.0.0.1:8000/api/events

# === SPA Authentication (Sanctum) ===
# Comma-separated list of allowed referrer domains for Sanctum cookie auth
# localhost:5173 = React dev server (Vite), localhost:8000/127.0.0.1:8000 = template UI
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:8000,::1

# === Agent Timeouts ===
# Maximum time (ms) the agent spends executing a single SQL query
# AGENT_QUERY_TIMEOUT_MS=30000
# Maximum time (seconds) the agent spends on one complete analysis stream
# AGENT_STREAM_TIMEOUT=180

# === Token Pricing (USD per 1,000,000 tokens) ===
# Defaults match DeepSeek V4 Flash regular rates.
# LLM_PRICE_INPUT_MISS=0.14
# LLM_PRICE_INPUT_HIT=0.0028
# LLM_PRICE_OUTPUT=0.28

# === Business Context Limits ===
# Per-entry caps (configurable). The global total across all active unscoped
# entries is FIXED at 6000 and must match agent/core.py::_format_business_context
# (max_chars=6000) — a boot warning fires if title+content can't coexist within it.
# BUSINESS_CONTEXT_TITLE_MAX=200
# BUSINESS_CONTEXT_CONTENT_MAX=5000
