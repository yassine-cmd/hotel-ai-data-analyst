# Leave EMPTY when using the Vite development proxy (see vite.config.js).
# The dev proxy routes /sanctum, /api and /analyze to Laravel (http://127.0.0.1:80).
# Set this only when the frontend is served separately from Laravel (then use
# the Laravel origin, e.g. http://localhost:80 — NOT the FastAPI service).
VITE_API_BASE_URL=
