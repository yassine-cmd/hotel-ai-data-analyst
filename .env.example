# === Required ===
LLM_API_KEY=sk-your-key-here

# === Model / LLM (any OpenAI-compatible endpoint) ===
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=128000
# LLM_REASONING_EFFORT=high        # low | high | max
# LLM_THINKING_ENABLED=true        # DeepSeek V4 ignores temp/top_p when on
# LLM_TEMPERATURE=1.0              # only sent when LLM_THINKING_ENABLED=false
# LLM_TOP_P=1.0                    # only sent when LLM_THINKING_ENABLED=false

# === Agent loop ===
# AGENT_MAX_STEPS=20
# AGENT_TOOL_TIMEOUT=120

# === Sandbox (Python code execution) ===
# SANDBOX_URL=http://localhost
# SANDBOX_TIMEOUT=30
# SANDBOX_IMAGE=code-sandbox:latest
# SANDBOX_POOL_MIN=2
# SANDBOX_MEM_LIMIT=512m
# SANDBOX_CPUS=1.0
# SANDBOX_PORT=9000
# SANDBOX_CONTAINER_READY_TIMEOUT=30
# SANDBOX_NETWORK=
# SANDBOX_POOL_MAX_OVERRIDE=
# SANDBOX_SKIP_BUILD=false
# SANDBOX_REBUILD=false             # force-rebuild the sandbox image at startup
# SANDBOX_HOST_HEADROOM_GIB=1.0

# === Session / Storage ===
# SESSION_DIR=./sessions
# Idle sessions: working state evicted from RAM after N minutes (NO data loss;
# lazily reloaded from disk on next turn). MEMORY-ONLY.
# SESSION_IDLE_MEMORY_MINUTES=30
# A session survives on disk for N days after its last activity before being
# permanently deleted (history + dataframes). This is the ONLY destructive TTL.
# SESSION_RETENTION_DAYS=90
# SESSION_QUERY_LIMIT=50
# SESSION_ROW_LIMIT=10000000
# SESSION_TIME_LIMIT_SECONDS=60.0
# SESSION_DATAFRAMES_MAX=15
# SESSION_DF_BUDGET_BYTES=134217728      # size budget for all persisted dfs (128 MiB); oldest evicted first
# ASSETS_TTL_HOURS=2
# ASSETS_BASE_URL=
# RECENT_ERRORS_MAX=5

# === Context Window ===
# CONTEXT_LIMIT=200000
# CONTEXT_LIVE_FRACTION=0.15
# CONTEXT_PERSIST_FRACTION=0.03
# CONTEXT_SUMMARIZE_THRESHOLD=32000

# === Prompt / Business Facts ===
# Resolved into the trailing [ENVIRONMENT FACTS] block of prompts/system_prompt.md
# DATA_SINCE=2025-03            # earliest month with data coverage
# CURRENCY=MAD

# === Instance Authentication (Ed25519) ===
# The admin Laravel instance Python reaches to fetch the client public-key registry.
ADMIN_LARAVEL_URL=http://127.0.0.1:80
# Admin instance's Ed25519 PUBLIC key (hex). Python uses this to verify
# admin-signed /admin/keys/* calls. Its matching private key lives ONLY in the
# admin Laravel instance's ADMIN_PRIVATE_KEY env var — never here.
ADMIN_PUBLIC_KEY=
# How often Python refreshes the client public-key registry from Laravel (s).
# PUBLIC_KEYS_REFRESH_SEC=60
# Max age of a signed request's X-Timestamp (s) before it is rejected (replay
# protection). Must match Laravel's python-proxy.signature_max_age.
# SIGNATURE_MAX_AGE_SEC=300

# === Server ===
# Python is internal-only (orchestration); Laravel is the public entry point.
# Keep APP_HOST=127.0.0.1 so the agent binds loopback. Expose only Laravel's
# port through the router/firewall.
# APP_HOST=127.0.0.1
# APP_PORT=8000
# LOG_LEVEL=INFO
# UVICORN_RELOAD=false

# === System audit event forwarding ===
# Python relays system audit events (its own + those reported by client
# Laravel instances) to the admin Laravel instance, which stores them in its
# daily system-audit log file. Disable only when no admin instance is reachable.
# EVENT_FORWARD_ENABLED=true
# Anti-spam window: repeated identical events (same event + client) are
# forwarded at most once per this many seconds.
# EVENT_FORWARD_THROTTLE_SECONDS=60

# === Diagnostics ===
# ENABLE_PROMPT_DIAGNOSTICS=false

# === Audit ===
# AUDIT_LOG_FILE=logs/audit.log

# === Backend Selection ===
# CLIENT_STORE_BACKEND=LOCAL
# STORAGE_BACKEND=LOCAL
